#include "pch.h"
#include "NetworkCommonLibPch.h"
#include "MHLib/serialization/ISerializable.h"
#include <functional>
#include <utility>
#include <vector>
#include "IncludePacketAll.g.h"
#include "{{ side }}PacketDispatch.g.h"
#include "I{{ side }}PacketHandler.g.h"

namespace {{ namespace }}
{
{% if side == 'Server' %}
	namespace
	{
		using PacketFunction = std::function<bool(UINT64, NetworkCommonLib::CSerializableBufferView &, IServerPacketHandler &)>;

{% if packets %}
		// 본문 검증에 성공하면 등록된 수신 핸들러를 호출한다.
		template<typename TPacket, bool (IServerPacketHandler::*Handler)(UINT64, const TPacket &) noexcept>
		bool HandlePacket(UINT64 sessionId, NetworkCommonLib::CSerializableBufferView &message, IServerPacketHandler &handler) noexcept
		{
			TPacket packet;
			return packet.Deserialize(message) && message.GetDataSize() == 0 && (handler.*Handler)(sessionId, packet);
		}

{% endif %}
		// 수신 방향의 패킷 핸들러를 opcode별로 한 번 등록한다.
		std::vector<PacketFunction> MakePacketFunctionTable()
		{
			std::vector<PacketFunction> funcTable({{ table_size }});
{% for packet in packets %}
			funcTable[static_cast<std::uint16_t>(EPacketType::{{ packet.name }})] =
				HandlePacket<S{{ packet.name }}, &IServerPacketHandler::Handle{{ packet.name }}>;
{% endfor %}
			return funcTable;
		}

		const auto kFuncTable = MakePacketFunctionTable();
	}

	bool DispatchServerPacket(UINT64 sessionId, NetworkCommonLib::CSerializableBufferView &message,
		IServerPacketHandler &handler, std::uint16_t *outOpcode) noexcept
	{
		std::uint16_t opcode = 0;
		message >> opcode;
		if (!message.IsValid())
			return false;
		if (outOpcode != nullptr)
			*outOpcode = opcode;
		if (opcode >= kFuncTable.size() || !kFuncTable[opcode])
			return false;
		return kFuncTable[opcode](sessionId, message, handler);
	}
{% else %}
	namespace
	{
		using PacketFunction = std::function<bool(NetworkCommonLib::CSerializableBuffer &, IClientPacketHandler &)>;

{% if packets %}
		// 본문 검증에 성공하면 등록된 수신 핸들러를 호출한다.
		template<typename TPacket, bool (IClientPacketHandler::*Handler)(const TPacket &) noexcept>
		bool HandlePacket(NetworkCommonLib::CSerializableBuffer &message, IClientPacketHandler &handler) noexcept
		{
			TPacket packet;
			message >> packet;
			return message.IsValid() && message.GetDataSize() == 0 && (handler.*Handler)(packet);
		}

{% endif %}
		// 수신 방향의 패킷 핸들러를 opcode별로 한 번 등록한다.
		std::vector<PacketFunction> MakePacketFunctionTable()
		{
			std::vector<PacketFunction> funcTable({{ table_size }});
{% for packet in packets %}
			funcTable[static_cast<std::uint16_t>(EPacketType::{{ packet.name }})] =
				HandlePacket<S{{ packet.name }}, &IClientPacketHandler::Handle{{ packet.name }}>;
{% endfor %}
			return funcTable;
		}

		const auto kFuncTable = MakePacketFunctionTable();
	}

	bool DispatchClientPacket(NetworkCommonLib::CSerializableBuffer &message, IClientPacketHandler &handler) noexcept
	{
		std::uint16_t opcode = 0;
		message >> opcode;
		if (!message.IsValid())
			return false;
		if (opcode >= kFuncTable.size() || !kFuncTable[opcode])
			return false;
		return kFuncTable[opcode](message, handler);
	}
{% endif %}
}
