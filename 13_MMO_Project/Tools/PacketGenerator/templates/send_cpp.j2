{% if side == 'Server' %}
#include "ServerNetworkLibPch.h"
{% else %}
#include "NetworkCommonLibPch.h"
{% endif %}
#include "CSerializableBuffer.h"
#include "MHLib/serialization/ISerializable.h"
#include "IncludePacketAll.g.h"
{% if side == 'Client' %}
#include "CClientManager.h"
#include "CClient.h"
#include "ClientPacketDispatch.g.h"
{% endif %}
#include "{{ send_stem }}.g.h"

namespace {{ namespace }}
{
{% if side == 'Client' %}
{% for packet in packets %}
	std::shared_ptr<NetworkCommonLib::CSerializableBuffer> MakePacket{{ packet.name }}(const S{{ packet.name }} &packet) noexcept
	{
		auto spBuffer = NetworkCommonLib::CSerializableBuffer::MakeShared();
		if (spBuffer == nullptr)
		{
			return nullptr;
		}

		*spBuffer << static_cast<std::uint16_t>(EPacketType::{{ packet.name }}) << packet;
		if (!spBuffer->IsValid())
		{
			return nullptr;
		}
		return spBuffer;
	}
{% if not loop.last %}

{% endif %}
{% endfor %}

	bool {{ client_class }}::onRecv(NetworkCommonLib::CSerializableBuffer &message) noexcept
	{
		return DispatchClientPacket(message, *this);
	}
{% else %}
	bool CServerPacketSender::SendPacket(UINT64 sessionId, const ServerNetworkLib::SendPacketPtr &spPacket) noexcept
	{
		auto *pPacket = spPacket.GetRealPtr();
		if (pPacket == nullptr)
			return false;
		sendPacket(sessionId, *pPacket);
		return true;
	}
{% endif %}
{% for packet in packets %}

	{{ packet.send_result }}{{ client_class if side == 'Client' else 'CServerPacketSender' }}::{{ packet.send_name }}({% if packet.send_parameters %}{{ '\n' -}}
{% for parameter in packet.send_parameters %}
		{{ parameter }}{{ ',' if not loop.last else ') noexcept' }}
{% endfor %}
{% else %}) noexcept{{ '\n' }}
{% endif %}
	{
		S{{ packet.name }} packet;
{% for field in packet.fields if side == 'Server' or field.cpp_type != 'std::wstring' %}
		packet.{{ field.member }} = {{ field.argument }};
{% endfor %}
{% if side == 'Client' and packet.copies_string %}
		try
		{
{% for field in packet.fields if field.cpp_type == 'std::wstring' %}
			packet.{{ field.member }} = {{ field.argument }};
{% endfor %}
		}
		catch (const std::bad_alloc &)
		{
			return false;
		}
{% endif %}
{% if side == 'Client' %}
		return this->sendPacket(MakePacket{{ packet.name }}(packet));
{% else %}
		return SendPacket(sessionId, MakePacket(packet));
{% endif %}
	}
{% endfor %}
}
