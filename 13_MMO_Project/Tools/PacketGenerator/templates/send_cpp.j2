	{{ 'std::shared_ptr<NetworkLib::CSerializableBuffer<FALSE>> ' if side == 'Client' else 'NetworkLib::CSerializableBuffer<FALSE> *' }}MakePacket{{ packet.name }}(const S{{ packet.name }} &packet) noexcept
	{
		auto {{ '' if side == 'Client' else '*' }}{{ buffer }} = NetworkLib::CSerializableBuffer<FALSE>::{{ 'MakeShared' if side == 'Client' else 'Alloc' }}();
		if ({{ buffer }} == nullptr)
		{
			return nullptr;
		}

		*{{ buffer }} << static_cast<std::uint16_t>(EPacketType::{{ packet.name }}) << packet;
